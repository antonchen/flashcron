ARG FEATURE=dep-manager
FROM debian:stable-slim AS runtime
ARG FEATURE
ENV DEBIAN_FRONTEND=noninteractive
ENV MALLOC_ARENA_MAX=2
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN printf 'APT::Install-Recommends "false";\nAPT::Install-Suggests "false";\n' > /etc/apt/apt.conf.d/90disable-suggests && \
    printf 'Acquire::http::Pipeline-Depth "0";\n' > /etc/apt/apt.conf.d/99nopipelining && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    locales tzdata procps iputils-ping ca-certificates curl wget jq && \
    if [ "$FEATURE" = dep-manager ]; then \
      apt-get install -y --no-install-recommends python3 python3-venv python3-pip && \
      python3 -m venv /opt/flashcron-venv; \
    fi && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc /usr/share/man && \
    mkdir -p /data

WORKDIR /tmp

FROM runtime AS runtime-web

FROM runtime AS runtime-dep-manager
ENV VIRTUAL_ENV=/opt/flashcron-venv
ENV PATH="/opt/flashcron-venv/bin:$PATH"

FROM runtime-${FEATURE}
ARG FEATURE
ARG TARGETARCH
COPY binaries/${FEATURE}/${TARGETARCH}/flashcron /usr/local/bin/flashcron
RUN chmod +x /usr/local/bin/flashcron

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["-c", "/data/config.toml"]
